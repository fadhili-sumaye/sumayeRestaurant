<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SUMAYERESTAURANT"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- Main Launcher Activity - Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SUMAYERESTAURANT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the QR code returned from the table-management API. -->
        <activity
            android:name=".ui.qr.QrOrderActivity"
            android:exported="true"
            android:label="Agiza Mezani"
            android:theme="@style/Theme.SUMAYERESTAURANT">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sumaye" android:host="order" />
            </intent-filter>
        </activity>

        <!-- Dashboard Router -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:label="@string/dashboard"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <!-- Role-Specific Dashboards -->
        <activity
            android:name=".ui.dashboard.OwnerDashboardActivity"
            android:exported="false"
            android:label="@string/owner"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.AdminDashboardActivity"
            android:exported="false"
            android:label="@string/admin"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.ManagerDashboardActivity"
            android:exported="false"
            android:label="@string/manager"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.WaiterDashboardActivity"
            android:exported="false"
            android:label="@string/waiter"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.CashierDashboardActivity"
            android:exported="false"
            android:label="@string/cashier"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.KitchenDashboardActivity"
            android:exported="false"
            android:label="@string/kitchen"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.StorekeeperDashboardActivity"
            android:exported="false"
            android:label="Mhifadhi Ghala"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.dashboard.DeliveryDashboardActivity"
            android:exported="false"
            android:label="Msambazaji"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <!-- Waiter Ordering Flow Activities (Phase 4) -->
        <activity
            android:name=".ui.waiter.TableListActivity"
            android:exported="false"
            android:label="@string/select_table"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.waiter.MenuActivity"
            android:exported="false"
            android:label="@string/choose_food"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.waiter.CartActivity"
            android:exported="false"
            android:label="@string/cart"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.waiter.OrderHistoryActivity"
            android:exported="false"
            android:label="@string/my_orders"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.waiter.OrderDetailActivity"
            android:exported="false"
            android:label="@string/order_details"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <!-- Cashier Billing & Payment Activities (Phase 6) -->
        <activity
            android:name=".ui.inventory.InventoryActivity"
            android:exported="false"
            android:label="Hisa za tawi"
            android:theme="@style/Theme.SUMAYERESTAURANT" />
        <activity android:name=".ui.inventory.InventoryDashboardActivity" android:exported="false" android:label="Usimamizi wa hisa" />
        <activity android:name=".ui.inventory.StockActionActivity" android:exported="false" android:label="Hisa" />
        <activity android:name=".ui.inventory.RecipePurchaseActivity" android:exported="false" android:label="Hisa" />
        <activity android:name=".ui.customer.CustomerActivity" android:exported="false" android:label="Wateja" />
        <activity android:name=".ui.reservation.ReservationActivity" android:exported="false" android:label="Uhifadhi wa Meza" />
        <activity android:name=".ui.delivery.DeliveryActivity" android:exported="false" android:label="Oda za Delivery" />
        <activity android:name=".ui.finance.ExpenseActivity" android:exported="false" android:label="Rekodi Gharama" />
        <activity android:name=".ui.finance.DailyClosingActivity" android:exported="false" android:label="Funga Siku" />
        <activity android:name=".ui.finance.ReportActivity" android:exported="false" android:label="Ripoti" />

        <activity
            android:name=".ui.cashier.PaymentActivity"
            android:exported="false"
            android:label="Malipo ya Ankara"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <activity
            android:name=".ui.cashier.ReceiptActivity"
            android:exported="false"
            android:label="Risiti ya Mauzo"
            android:theme="@style/Theme.SUMAYERESTAURANT" />

        <!-- Original MainActivity (stub) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SUMAYERESTAURANT" />
    </application>

</manifest>
