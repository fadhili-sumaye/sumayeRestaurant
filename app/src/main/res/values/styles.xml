<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Typography (Poppins) ============ -->
    <style name="TextAppearance.Sumaye.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="TextAppearance.Sumaye.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/green_bright</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.CardLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="Widget.Sumaye.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Sumaye.Card.Green">
        <item name="strokeColor">@color/green_outline</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Widget.Sumaye.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Sumaye.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Sumaye.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/status_error_background</item>
        <item name="android:textColor">@color/error_color</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Sumaye.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- ============ Text Fields ============ -->
    <style name="Widget.Sumaye.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card_secondary</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/secondary_text</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- ============ Chips ============ -->
    <style name="Widget.Sumaye.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/card_secondary</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- ============ Bottom Navigation ============ -->
    <style name="Widget.Sumaye.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">@color/nav_ripple</item>
        <item name="itemIconSize">28dp</item>
        <item name="elevation">8dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
</resources>