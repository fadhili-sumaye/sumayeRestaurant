<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Typography (Poppins) ============ -->
    <style name="TextAppearance.Sumaye.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="TextAppearance.Sumaye.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/green_bright</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Sumaye.CardLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="Widget.Sumaye.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>
    <style name="Widget.Sumaye.Card.Green">
        <item name="strokeColor">@color/green_outline</item>
    </style>

    <!-- Pinterest-style pin card: rounded, subtle elevation, no stroke -->
    <style name="Widget.Sumaye.PinCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- Pinterest-style pin card with image: larger radius on top -->
    <style name="Widget.Sumaye.PinImageCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Widget.Sumaye.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="elevation">4dp</item>
    </style>
    <style name="Widget.Sumaye.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Sumaye.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="backgroundTint">@color/status_error_background</item>
        <item name="android:textColor">@color/error_color</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Sumaye.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">27dp</item>
    </style>

    <!-- Pinterest-style pill button -->
    <style name="Widget.Sumaye.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- ============ Text Fields ============ -->
    <style name="Widget.Sumaye.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card_secondary</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/hint_color</item>
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- ============ Chips ============ -->
    <style name="Widget.Sumaye.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pin_chip_inactive</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/pin_chip_inactive_text</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <style name="Widget.Sumaye.Chip.Selected" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pin_chip_active</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/pin_chip_active_text</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <!-- ============ Bottom Navigation ============ -->
    <style name="Widget.Sumaye.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">@color/nav_ripple</item>
        <item name="itemIconSize">26dp</item>
        <item name="elevation">12dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
</resources>
