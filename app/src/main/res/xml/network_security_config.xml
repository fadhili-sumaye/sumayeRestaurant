<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Network Security Configuration
    - Allows cleartext HTTP only to local/development addresses (emulator, LAN)
    - Requires HTTPS for all production cloud domains
    - Add your production domain to the 'domain' entry to enforce HTTPS automatically
-->
<network-security-config>

    <!-- Release builds require encrypted traffic everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Explicit production endpoint rule. -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Replace with your actual domain when deploying to cloud -->
        <domain includeSubdomains="true">sumaye-backdb.onrender.com</domain>
    </domain-config>

</network-security-config>
