<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Large hero image -->
    <FrameLayout
        android:id="@+id/heroFrame"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:fitsSystemWindows="true">

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_overlay" />

        <!-- Floating back -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|start"
            app:cardCornerRadius="23dp"
            app:cardBackgroundColor="#E61E1E1E"
            app:strokeWidth="0dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Floating favorite / save (Pinterest pin) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/favButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|end"
            app:cardCornerRadius="23dp"
            app:cardBackgroundColor="#E61E1E1E"
            app:strokeWidth="0dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/favHeartIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/white" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Overlapping detail card (Pinterest bottom sheet style) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-32dp"
        android:paddingBottom="100dp"
        android:background="@drawable/bg_rounded_top_surface"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Drag indicator -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_chip_selected" />

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:fontFamily="@font/poppins_bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/detailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="   ·   "
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detailPrep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

            <TextView
                android:id="@+id/detailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/food_accent"
                android:textSize="32sp"
                android:fontFamily="@font/poppins_bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maelezo"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_secondary"
                app:strokeWidth="0dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muhtasari"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:id="@+id/detailAvailability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky bottom bar (Pinterest-style rounded) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeWidth="0dp"
        app:cardElevation="16dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/card_secondary"
                android:paddingHorizontal="4dp"
                android:clipToOutline="true">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/minusButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardCornerRadius="19dp"
                    app:cardBackgroundColor="@color/surface_raised"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/white" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/quantityTextView"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/plusButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardCornerRadius="19dp"
                    app:cardBackgroundColor="@color/food_accent"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/food_on_accent" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addToCartButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:backgroundTint="@color/food_accent"
                android:textColor="@color/food_on_accent"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:text="Ongeza Kwenye Kikapu" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
