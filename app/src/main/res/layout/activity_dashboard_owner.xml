<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/dark_blue">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karibu!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/roleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mmiliki wa Mgahawa (Executive Dashboard)"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Scrollable Features Grid -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Reports & Profit/Loss -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Ripoti za Mauzo &amp; Faida"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tazama jumla ya mapato, faida, na mienendo ya kifedha."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Daily Closing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerDailyClosing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Funga Siku ya Biashara (Z-Report)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ulinganifu wa fedha taslimu, ankara, na kufunga mahesabu ya siku."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Expenses -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Gharama &amp; Matumizi"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rekodi na udhibiti gharama za uendeshaji za kila siku."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Inventory & Stock -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerInventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Hisa &amp; Usimamizi wa Stoo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hali ya viungo, upungufu wa stoo, mapishi, na ununuzi."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Cashier & Billing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerCashier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳 Malipo &amp; Ankara (Cashier Flow)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tazama ankara zilizo wazi, malipo yaliyopokelewa, na risiti."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6: Waiter & Orders -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerWaiter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽️ Meza &amp; Oda (Waiter Flow)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tazama hali ya meza na uingizaji wa oda kwa wateja."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 7: Kitchen Display -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerKitchen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍳 Skrini ya Jikoni (KDS)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oda zinazopikwa na kukamilishwa jikoni."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 8: Customers & CRM -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerCustomers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥 Orodha ya Wateja"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tafuta na sajili wateja na taarifa zao."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 9: Reservations -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerReservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Uhifadhi wa Meza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weka na udhibiti meza zilizohifadhiwa na wateja."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 10: Delivery -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/dark_blue_divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/dark_blue_surface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚 Oda za Delivery"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fuatilia maagizo ya kupelekwa na madereva."
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🔑 Badili Nenosiri"
            android:textSize="13sp"
            android:padding="12dp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/dark_blue_surface"
            android:textColor="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetStaffPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="👤 Weka Upya Staff"
            android:textSize="13sp"
            android:padding="12dp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/brand_green"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/dark_blue_surface"
            android:textColor="@color/brand_green" />
    </LinearLayout>

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logout"
        android:textSize="15sp"
        android:padding="14dp"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/error_color" />

    <!-- Role-based Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom_owner"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
