<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarKitchen"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="Jikoni - KOT Queue"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_menu_dots"
        app:navigationIconTint="@color/primary" />

    <!-- Connection Status Banner -->
    <LinearLayout
        android:id="@+id/layoutConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/status_success_background"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mtandao umeunganishwa"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" />

        <ImageButton
            android:id="@+id/btnSoundToggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:contentDescription="Sauti"
            android:tint="@color/primary" />
    </LinearLayout>

    <!-- Filter & Sort Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="@color/surface">

        <!-- Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zote"
                    android:textColor="@color/pin_chip_active_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipFilterNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mpya"
                    android:textColor="@color/pin_chip_inactive_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipFilterPreparing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zinaandaliwa"
                    android:textColor="@color/pin_chip_inactive_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipFilterReady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tayari"
                    android:textColor="@color/pin_chip_inactive_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Count and Sort Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvActiveOrdersCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oda Zinazoendelea: 0"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/btnToggleSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ya Zamani Kwanza"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarKitchen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyKitchen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hakuna oda zinazoendelea jikoni kwa sasa."
        android:textAlignment="center"
        android:textColor="@color/secondary_text"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginTop="64dp"
        android:visibility="gone" />

    <!-- KOT Queue RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewKitchenOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
