<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPayment"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_dark"
        app:title="ðŸ’³ Pokea Malipo ya Ankara"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bill Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPaymentBillHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ANKARA #BILL-0001 â€¢ Meza 8"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Subtotal Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jumla Ndogo (Subtotal):"
                            android:textColor="@color/secondary_text" />
                        <TextView
                            android:id="@+id/tvPaymentSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TZS 25,000"
                            android:textStyle="bold"
                            android:textColor="@color/text_color" />
                    </LinearLayout>

                    <!-- Discount Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Punguzo (Discount):"
                            android:textColor="@color/secondary_text" />
                        <TextView
                            android:id="@+id/tvPaymentDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-TZS 0"
                            android:textStyle="bold"
                            android:textColor="@color/error_color" />
                        <TextView
                            android:id="@+id/btnApplyDiscountDialog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[ Weka Punguzo ]"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Tax Row -->
                    <LinearLayout
                        android:id="@+id/layoutTaxRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:id="@+id/tvPaymentTaxLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kodi (VAT 18%):"
                            android:textColor="@color/secondary_text" />
                        <TextView
                            android:id="@+id/tvPaymentTaxAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TZS 0"
                            android:textStyle="bold"
                            android:textColor="@color/text_color" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Total Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="JUMLA KUU:"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_color" />
                        <TextView
                            android:id="@+id/tvPaymentTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TZS 25,000"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <!-- Balance Due Highlight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:padding="8dp"
                        android:background="@color/status_error_background">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Salio Linalodaiwa:"
                            android:textStyle="bold"
                            android:textColor="@color/error_color" />
                        <TextView
                            android:id="@+id/tvPaymentBalanceDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TZS 25,000"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/error_color" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Method Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chagua Njia ya Malipo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color" />

                    <RadioGroup
                        android:id="@+id/radioGroupPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rbCash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ðŸ’µ Pesa Taslimu (Cash)"
                            android:checked="true"
                            android:textSize="15sp"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbMobileMoney"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ðŸ“± Pesa za Simu (Mobile Money)"
                            android:textSize="15sp"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ðŸ’³ Kadi (Card / POS)"
                            android:textSize="15sp"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbBank"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ðŸ¦ Benki (Bank Transfer)"
                            android:textSize="15sp"
                            android:padding="4dp" />
                    </RadioGroup>

                    <!-- Amount To Pay Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAmountToPay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Kiasi Kinacholipwa (TZS)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmountToPay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Cash Details Container -->
                    <LinearLayout
                        android:id="@+id/layoutCashDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCashReceived"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Kiasi Kilichopokelewa kutoka kwa Mteja (TZS)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCashReceived"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Change Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/status_success_background">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Chenji ya Mteja:"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_dark" />

                            <TextView
                                android:id="@+id/tvCalculatedChange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TZS 0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_dark" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Mobile Money Details Container -->
                    <LinearLayout
                        android:id="@+id/layoutMobileMoneyDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mtandao wa Simu:"
                            android:textSize="13sp"
                            android:textColor="@color/secondary_text" />

                        <Spinner
                            android:id="@+id/spinnerMobileProvider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTransactionRef"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Namba ya Muamala / Reference No"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTransactionRef"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Confirm Button Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/dark_blue_surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Thibitisha Malipo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary_dark" />
    </LinearLayout>

</LinearLayout>
