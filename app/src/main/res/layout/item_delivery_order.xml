<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/dark_blue_card"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/dark_blue_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Order Number & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oda #1001"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAFARINI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_rounded_bg"
                android:textColor="@color/text_color" />
        </LinearLayout>

        <!-- Customer Row with Call Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mteja: Juma Ally"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color" />

                <TextView
                    android:id="@+id/tvCustomerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+255 712 345 678"
                    android:textSize="13sp"
                    android:textColor="@color/secondary_text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Piga"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/brand_green"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Address Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDeliveryAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kariakoo, Mtaa wa Msimbazi karibu na kituo"
                android:textSize="13sp"
                android:textColor="@color/secondary_text" />
        </LinearLayout>

        <!-- Fee & Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDeliveryFee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ada ya Delivery: TZS 3,000"
                android:textSize="13sp"
                android:textColor="@color/warning_color" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kukusanya: TZS 15,000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_color" />
        </LinearLayout>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeliveryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Niko Njiani (Anza Safari)"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/dark_blue" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
