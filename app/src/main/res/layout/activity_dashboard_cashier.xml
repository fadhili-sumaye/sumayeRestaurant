<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCashier"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="Hazina - Ankara na Malipo"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_menu_dots"
        app:navigationIconTint="@color/primary" />

    <!-- Connection Status Banner -->
    <LinearLayout
        android:id="@+id/layoutCashierConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/status_success_background"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCashierConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mtandao umeunganishwa"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" />

        <ImageButton
            android:id="@+id/btnRefreshCashier"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh"
            android:tint="@color/primary" />
    </LinearLayout>

    <!-- Metrics Cards Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/surface"
        android:weightSum="3">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mauzo ya Leo"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/secondary_text" />

                <TextView
                    android:id="@+id/tvTodaySales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TZS 0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hazijalipwa"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/secondary_text" />

                <TextView
                    android:id="@+id/tvUnpaidBillsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/error_color"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zilizolipwa"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/secondary_text" />

                <TextView
                    android:id="@+id/tvPaidBillsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/success_color"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Search & Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="@color/surface">

        <!-- Filter Chips Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterUnpaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zisizolipwa"
                android:textColor="@color/pin_chip_active_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipFilterPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zilizolipwa"
                android:textColor="@color/pin_chip_inactive_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipFilterAllBills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zote"
                android:textColor="@color/pin_chip_inactive_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- Search Input -->
        <EditText
            android:id="@+id/etSearchBills"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Tafuta kwa Meza au Namba ya Oda..."
            android:background="@drawable/bg_search_edittext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_color"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarCashier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyBills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hakuna ankara katika kundi hili."
        android:textAlignment="center"
        android:textColor="@color/secondary_text"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginTop="64dp"
        android:visibility="gone" />

    <!-- Bills Queue RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBills"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
