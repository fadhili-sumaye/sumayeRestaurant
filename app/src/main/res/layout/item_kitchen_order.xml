<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardKitchenOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Row: Order Number & Elapsed Time Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvKotOrderNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ODA #ORD-00025"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_color" />

            <TextView
                android:id="@+id/tvKotElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ Dakika 8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#ECEFF1"
                android:textColor="#37474F" />
        </LinearLayout>

        <!-- Subtitle: Table & Waiter & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvKotTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Meza: 8 (Kula Hapa)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_green_dark" />

                <TextView
                    android:id="@+id/tvKotWaiter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Mhudumu: John Doe"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKotStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oda Mpya"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_reserved"
                android:textColor="@color/primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewKotItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Order Notes if present -->
        <TextView
            android:id="@+id/tvKotNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dokezo: Wahi haraka sana"
            android:textSize="13sp"
            android:textColor="#E65100"
            android:background="#FFF3E0"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelKot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghairi"
                android:textColor="@color/error_color"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKotAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pokea Oda"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/primary" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
