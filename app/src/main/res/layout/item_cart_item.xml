<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCartItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Biryani ya Kuku"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color" />

            <ImageButton
                android:id="@+id/btnRemoveCartItem"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/error_color"
                android:contentDescription="@string/remove" />
        </LinearLayout>

        <!-- Special instructions button / badge -->
        <TextView
            android:id="@+id/tvCartItemInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✍️ Weka maelezo ya pekee"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Quantity & Subtotal Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Quantity Stepper -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnCartMinus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_counter_btn"
                    android:src="@android:drawable/ic_input_delete"
                    android:tint="@color/brand_green"
                    android:contentDescription="@string/remove" />

                <TextView
                    android:id="@+id/tvCartQuantity"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color" />

                <ImageButton
                    android:id="@+id/btnCartPlus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_counter_btn"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/brand_green"
                    android:contentDescription="@string/add_to_cart" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCartItemSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TZS 12,000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand_green" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
