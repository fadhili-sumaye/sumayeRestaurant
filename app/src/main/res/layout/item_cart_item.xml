<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivCartItemImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_counter_btn"
                android:contentDescription="Food image" />

            <TextView
                android:id="@+id/tvCartItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Biryani ya Kuku"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_color" />

            <ImageButton
                android:id="@+id/btnRemoveCartItem"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/error_color"
                android:contentDescription="@string/remove" />
        </LinearLayout>

        <!-- Special instructions button / badge -->
        <TextView
            android:id="@+id/tvCartItemInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weka maelezo ya pekee"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Quantity & Subtotal Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Quantity Stepper -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/card_secondary"
                android:padding="2dp"
                android:clipToOutline="true">

                <ImageButton
                    android:id="@+id/btnCartMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_counter_btn"
                    android:src="@android:drawable/ic_input_delete"
                    android:tint="@color/primary"
                    android:contentDescription="@string/remove" />

                <TextView
                    android:id="@+id/tvCartQuantity"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_color" />

                <ImageButton
                    android:id="@+id/btnCartPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_counter_btn"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/primary"
                    android:contentDescription="@string/add_to_cart" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCartItemSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TZS 12,000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/primary" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>