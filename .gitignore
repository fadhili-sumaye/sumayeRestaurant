# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
/build
target/
restaurant-management-api/target/

# Local Maven dependency cache (hundreds of MB of jars - NEVER commit)
.m2-cache/
restaurant-management-api/.m2-cache/

# Gradle files
.gradle/
.gradle-user/
build/

# Local configuration file (contains path to Android SDK, etc.)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log
*.log.*
logs/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/caches/

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx

# Google Services (Firebase if any)
google-services.json

# Environment Variables & Secrets (CRITICAL FOR CLOUD SECURITY)
.env
*.env
.env.local
.env.*.local
*.env.*
restaurant-management-api/.env
restaurant-management-api/*.env

# OS-specific
.DS_Store
Thumbs.db

# Database Dumps containing real data
*.sql.gz
*.dump
*_dump.sql
sumaye_dump.sql
backup/

# Local CA certificates (Aiven SSL)
# The Aiven bundle we commit into src/main/resources is a PUBLIC certificate
# (no private key). It is safe to track so the image can verify the server cert.
# Ignore any OTHER .pem in the repo (e.g. private keys) but whitelist our public cert.
*.pem
!**/src/main/resources/aiven-ca.pem

# Cursor / editor local
.cursor/
